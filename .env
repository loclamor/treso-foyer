# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
#
# DATABASE_URL="sqlite:///%kernel.project_dir%/var/data_%kernel.environment%.db"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=8.0.32&charset=utf8mb4"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=10.11.2-MariaDB&charset=utf8mb4"
DATABASE_URL="postgresql://banque:!ChangeMe!@database:5432/banque?serverVersion=17&charset=utf8"
###< doctrine/doctrine-bundle ###

###> front (Vite) ###
# Clé de licence PrimeUI (PrimeVue 5). À définir dans .env.local (non versionné).
# Licence Community gratuite pour un particulier : https://primeui.dev/licenses/community
VITE_PRIMEUI_LICENSE=
###< front (Vite) ###

###> app/banque ###
# Pepper HMAC pour l'empreinte des numéros de compte (App\Security\AccountNumberHasher).
# Valeur de développement par défaut : à remplacer par un secret dans .env.local (non versionné).
ACCOUNT_NUMBER_PEPPER=change-me-in-env-local
###< app/banque ###

###> app/vehicules ###
# Fournisseur de recherche de véhicule par plaque : none (désactivé) ou rapidapi.
VEHICLE_LOOKUP_PROVIDER=none
# Clé API RapidAPI « API Plaque Immatriculation France ». Ne JAMAIS committer :
# renseigner la vraie clé dans .env.local (non versionné).
VEHICLE_LOOKUP_TOKEN=
###< app/vehicules ###

###> app/backup ###
# Sauvegarde automatique de la base : dump pg_dump gzipé dans data/backups/, lancé en
# arrière-plan par le conteneur php (frankenphp/docker-entrypoint.sh). Voir docs/adr/0019.
# BACKUP_ENABLED=true pour activer (à placer plutôt dans .env.local, non versionné).
BACKUP_ENABLED=false
# Fréquence : nombre de secondes ou suffixe m/h/d/w (ex. 3600, 30m, 12h, 1d, 1w).
BACKUP_INTERVAL=1d
# Rotation : nombre de dumps conservés, les plus anciens sont supprimés.
BACKUP_KEEP=14
# Upload externe des dumps via rclone (service « backup-remote », à activer avec
# COMPOSE_PROFILES=backup-remote dans .env.local). Exemple : gdrive:treso-foyer/backups
# (vide = désactivé). Identifiants rclone en variables d'environnement, ex. dans .env.local :
# RCLONE_CONFIG_GDRIVE_TYPE=drive et RCLONE_CONFIG_GDRIVE_TOKEN={"access_token":...} —
# voir DEPLOY.md § « Sauvegardes externes (Google Drive) » pour obtenir le token.
BACKUP_REMOTE=
BACKUP_REMOTE_INTERVAL=1d
###< app/backup ###

###> docker ###
# Port HTTP publié sur l'hôte par docker compose (compose.yaml). 8180 est pris
# par un autre service sur ce poste, d'où 8181. HTTPS reste sur 8543.
HTTP_PORT=8181
###< docker ###
